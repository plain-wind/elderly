{
  "compilerOptions": {
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ESNext",
    "baseUrl": ".",
    "lib": [
      "DOM",
      "ESNext"
    ],
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "types": [
      "@amap/amap-jsapi-types",
    ]
  },
  "include": [
    "src/**/*",
    "components.d.ts",
    "auto-imports.d.ts",
    "vite-env.d.ts"
  ],
}